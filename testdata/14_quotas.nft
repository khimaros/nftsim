table inet filter {
    # counters and quotas under test
    
    counter http_counter {}
    counter https_counter {}
    counter icmp_counter {}
    
    quota http_quota {
        over 1 mbytes
    }
    
    chain forward {
        type filter hook forward priority 0; policy drop;
        
        # count all HTTP traffic
        tcp dport 80 counter name http_counter accept
        
        # count all HTTPS traffic
        tcp dport 443 counter name https_counter accept
        
        # count ICMP
        icmp type echo-request counter name icmp_counter accept
        
        # allow established/related
        ct state established,related accept
        
        # allow DNS
        udp dport 53 accept
    }
    
    chain input {
        type filter hook input priority 0; policy drop;
        
        # allow loopback
        iif lo accept
        
        # allow established/related
        ct state established,related accept
        
        # allow ICMP
        icmp type echo-request accept
    }
    
    chain output {
        type filter hook output priority 0; policy accept;
    }
}

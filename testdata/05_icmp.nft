#!/usr/sbin/nft -f
# ruleset for ICMP tests

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;
        
        # allow established/related
        ct state established,related counter accept
        
        # allow loopback
        iif "lo" counter accept
        
        # allow ICMP echo request from internal network
        ip saddr 192.168.1.0/24 icmp type echo-request counter accept
        
        # drop everything else
        counter drop
    }
    
    chain forward {
        type filter hook forward priority 0; policy drop;
        
        # drop invalid packets
        ct state invalid counter drop
        
        # allow established/related connections
        ct state established,related counter accept
        
        # allow ICMP echo requests from internal network
        ip saddr 192.168.1.0/24 icmp type echo-request ct state new counter accept
        
        # allow ICMP echo replies
        icmp type echo-reply counter accept
        
        # drop external to internal
        ip daddr 192.168.1.0/24 counter drop
    }
}

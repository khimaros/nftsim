table inet filter {
    chain forward {
        type filter hook forward priority 0; policy drop;
        
        ct state established,related accept
        
        # allow specific protocols outbound
        iifname "eth0" oifname "eth1" tcp dport { 80, 443, 22, 25, 587 } accept
        iifname "eth0" oifname "eth1" udp dport { 53, 123, 514 } accept
        iifname "eth0" oifname "eth1" icmp type echo-request accept
        
        # return traffic
        iifname "eth1" oifname "eth0" accept
    }
    
    chain input {
        type filter hook input priority 0; policy drop;
        
        iif lo accept
        ct state established,related accept
        
        # allow SSH to firewall
        tcp dport 22 accept
        
        # allow DNS queries to firewall
        udp dport 53 accept
        
        # allow ping to firewall
        icmp type echo-request accept
    }
    
    chain output {
        type filter hook output priority 0; policy accept;
    }
}

table inet filter {
    chain prerouting {
        type nat hook prerouting priority -100; policy accept;
        
        # port forwarding: external :80 -> internal web server :8080
        iifname "eth1" ip daddr 203.0.113.10 tcp dport 80 dnat to 192.168.1.100:8080
        
        # port forwarding: external :443 -> internal HTTPS server :8443
        iifname "eth1" ip daddr 203.0.113.10 tcp dport 443 dnat to 192.168.1.100:8443
        
        # port forwarding: external :2222 -> internal SSH server :22
        iifname "eth1" ip daddr 203.0.113.10 tcp dport 2222 dnat to 192.168.1.50:22
        
        # DNS forwarding: external :53 UDP -> internal DNS server :53
        iifname "eth1" ip daddr 203.0.113.10 udp dport 53 dnat to 192.168.1.200:53
        
        # port range forwarding: external :3000-3010 -> internal :3000-3010
        iifname "eth1" ip daddr 203.0.113.10 tcp dport 3000-3010 dnat to 192.168.1.150
    }
    
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        
        # masquerade outbound traffic
        oifname "eth1" masquerade
    }
    
    chain forward {
        type filter hook forward priority 0; policy drop;
        
        # allow port-forwarded traffic
        iifname "eth1" oifname "eth0" ct status dnat accept
        
        # allow established/related connections
        ct state established,related accept
        
        # allow outbound traffic from internal network
        iifname "eth0" oifname "eth1" accept
    }
    
    chain input {
        type filter hook input priority 0; policy drop;
        
        # allow loopback
        iif lo accept
        
        # allow established/related
        ct state established,related accept
    }
    
    chain output {
        type filter hook output priority 0; policy accept;
    }
}

#!/usr/sbin/nft -f

#flush ruleset

define wan_dev = { "wlp170s0" }

define vpn_dev = { "wg0", "wg1" }

#flush table filter
table inet filter {
        chain INPUT {
                type filter hook input priority filter; policy drop;

                # accept all loopback packets
                iif "lo" accept

                # accept all icmp/icmpv6 packets
                meta l4proto { icmp, ipv6-icmp } counter accept

                # accept packets that are part of an established connection
                ct state established,related counter accept

                # accept all DHCPv6 packets received at a link-local address
                ip6 daddr fe80::/64 udp dport dhcpv6-client counter accept

                # expose openssh server to wan and vpn
                #iifname $wan_dev tcp dport 22 counter accept
                #iifname $vpn_dev tcp dport 22 counter accept

		# expose kodi server to vpn
                #iifname $vpn_dev tcp dport 8080 counter accept

		# expose wireguard-proxy on wan
                #iifname $wan_dev udp dport 51820 counter accept

		# accept mdns resolutions
		iifname $wan_dev udp dport 5353 counter accept
		iifname $wan_dev tcp dport 5355 counter accept
		iifname $wan_dev udp dport 5355 counter accept

		# accept mavlink data
		iifname $wan_dev udp dport 14550 counter accept
        }

	chain FORWARD {
		type filter hook forward priority filter;
	}

	chain OUTPUT {
		type filter hook output priority filter;
	}
}

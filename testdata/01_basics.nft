#!/usr/sbin/nft -f
# Comprehensive test ruleset for nftsim

flush ruleset

table inet filter {
    # Define sets for allowed services
    set allowed_tcp_ports {
        type inet_service
        elements = { 80, 443, 22 }
    }
    
    set blocked_ips {
        type ipv4_addr
        elements = { 10.0.0.100 }
    }
    
    chain input {
        type filter hook input priority 0; policy accept;
        log prefix "nft-input: " counter
    }
    
    chain forward {
        type filter hook forward priority 0; policy drop;
        
        # Log ALL packets
        log prefix "nft-forward: " counter
        
        # Drop invalid packets
        ct state invalid counter drop
        
        # Allow established/related connections
        ct state established,related counter accept
        
        # Block traffic from/to blocked IPs
        ip saddr @blocked_ips counter log prefix "nft-blocked-src: " drop
        ip daddr @blocked_ips counter log prefix "nft-blocked-dst: " drop
        
        # Allow internal network (192.168.1.0/24) to access allowed services
        ip saddr 192.168.1.0/24 tcp dport @allowed_tcp_ports ct state new counter accept
        
        # Allow internal network to access DNS
        ip saddr 192.168.1.0/24 udp dport 53 ct state new counter accept
        
        # Allow ICMP echo requests from internal network
        ip saddr 192.168.1.0/24 icmp type echo-request counter accept
        
        # Explicitly drop and log anything from external trying to reach internal
        ip daddr 192.168.1.0/24 counter log prefix "nft-ext-to-int: " drop
        
        # Log all other dropped packets
        log prefix "nft-drop: " counter
    }
}

table inet filter {
    chain forward {
        type filter hook forward priority 0; policy drop;
        
        ct state established,related accept
        
        # Drop packets with TTL <= 1 (would expire in transit)
        ip ttl 0-1 drop
        
        # Allow valid TTL packets
        iifname "eth0" oifname "eth1" ip ttl 2-255 tcp dport 80 accept
        iifname "eth0" oifname "eth1" ip ttl 2-255 udp dport 53 accept
        iifname "eth0" oifname "eth1" ip ttl 2-255 icmp type echo-request accept
        
        # Allow established return traffic
        iifname "eth1" oifname "eth0" accept
    }
    
    chain input {
        type filter hook input priority 0; policy drop;
        
        iif lo accept
        ct state established,related accept
        
        # Drop expired packets
        ip ttl 0-1 drop
        
        # Allow valid TTL
        ip ttl 2-255 accept
    }
    
    chain output {
        type filter hook output priority 0; policy accept;
    }
}

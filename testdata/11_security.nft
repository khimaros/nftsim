table inet filter {
    # invalid packet handling and security tests
    
    chain forward {
        type filter hook forward priority 0; policy drop;
        
        # drop invalid packets
        ct state invalid drop
        
        # allow established/related
        ct state established,related accept
        
        # allow new connections from internal to external
        iifname "eth0" oifname "eth1" ct state new accept
        
        # block external to internal (established/related is handled above)
        iifname "eth1" oifname "eth0" drop
    }
    
    chain input {
        type filter hook input priority 0; policy drop;
        
        # allow loopback
        iif lo accept
        
        # drop invalid packets
        ct state invalid drop
        
        # allow established/related
        ct state established,related accept
        
        # allow ICMP from internal network only
        iifname "eth0" icmp type echo-request accept
        
        # allow SSH from internal network only
        iifname "eth0" tcp dport 22 accept
    }
    
    chain output {
        type filter hook output priority 0; policy accept;
    }
}

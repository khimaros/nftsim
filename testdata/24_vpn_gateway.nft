#!/usr/sbin/nft -f

#flush ruleset

define wan_dev = { "eth0" }
define wan_addr = { 203.0.113.251 }
define wan_addr6 = { 2001:db8::1 }
define wan_net6 = { 2001:db8::1/64 }

define vpn_dev = { "wg0" }
define vpn_net = { 10.1.200.0/24 }
define vpn_net6 = { 2001:db8:200::1/80 }

define peer_hermes = { 10.1.200.1, 10.1.200.150 }
define peer_aether = { 10.1.200.50 }
define peer_deimos = { 10.1.200.115 }
define peer_echo = { 10.1.200.135 }
define peer_nemesis = { 10.1.200.155 }
define peer_kodi_lr = { 10.1.200.170 }
define peer_kiste = { 10.1.200.225 }
define peer_ares = { 10.1.200.230 }
define peer_perseus = { 10.1.200.240 }

define peer6_hermes = { 2001:db8:200::150/128 }
define peer6_ares = { 2001:db8:200::230/128 }
define peer6_perseus = { 2001:db8:200::240/128 }

table inet filter {
	chain INPUT {
		type filter hook input priority filter; policy drop;

		# accept all loopback packets
		iif "lo" accept

		# accept all icmp/icmpv6 packets
		meta l4proto { icmp, ipv6-icmp } counter accept

		# accept packets that are part of an established connection
	        ct state established,related counter accept

		# accept all DHCPv6 packets received at a link-local address
		ip6 daddr fe80::/64 udp dport dhcpv6-client counter accept

		# expose openssh server to wan and vpn
		iifname $wan_dev tcp dport 22 counter accept
		iifname $vpn_dev tcp dport 22 counter accept

		# expose bind9 server to vpn
		iifname $vpn_dev udp dport 53 counter accept
		iifname $vpn_dev tcp dport 53 counter accept

		# expose wireguard server to wan
		iifname $wan_dev udp dport 51820 counter accept

		# expose iperf server to vpn
		iifname $vpn_dev tcp dport 5201 counter accept

		# expose netdata server to some vpn peers
		#iifname $vpn_dev ip saddr $peer_perseus tcp dport 19999 counter accept

		# expose wireguard-proxy to wan
		iifname $wan_dev tcp dport 443 counter accept

		# reject all other vpn traffic
		iifname $vpn_dev counter reject

		# drop everything else
		iifname $wan_dev counter drop
		counter drop
	}

	chain FORWARD {
		type filter hook forward priority filter; policy drop;

		# accept all icmp/icmpv6 packets
		meta l4proto { icmp, ipv6-icmp } counter accept

		# accept packets that are part of an established connection
	        ct state established,related counter accept

		# forward all traffic from specific vpn peers to any wan peer
		# NOTE: requires matching rule in inet nat POSTROUTING
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_aether counter accept
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_deimos counter accept
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_perseus counter accept
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_ares counter accept
		# FIXME: this is only necessary because AllowedIps is not honored by LibreELEC
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_kodi_lr counter accept

		# forward all ipv6 traffic from specific vpn peers to any wan peer
		# NOTE: requires matching rule in inet nat POSTROUTING
		iifname $vpn_dev oifname $wan_dev ip6 saddr $peer6_ares counter accept
		#iifname $vpn_dev oifname $wan_dev ip6 saddr $peer6_perseus counter accept

		# forward all traffic from vpn to wan (LESS SECURE!)
		# NOTE: this is only relevant for ipv6 clients
		#iifname $vpn_dev oifname $wan_dev counter accept

		# forward vpn traffic from specific vpn peer to specific vpn peer:port
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_echo ip daddr $peer_kiste tcp dport 443 counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_echo ip daddr $peer_kiste tcp dport 80 counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_ares ip daddr $peer_kodi_lr tcp dport 8080 counter accept

		# forward vpn traffic between specific vpn peers
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_ares ip daddr $peer_aether counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_ares ip daddr $peer_deimos counter accept
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_perseus ip daddr $peer_nemesis counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_ares ip daddr $peer_kodi_lr counter accept

		# forward vpn traffic from any vpn peer to specific vpn peer:port
		# FIXME: deimos 443 is a pretty large attack vector
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_deimos tcp dport 443 counter accept
		#iifname $vpn_dev oifname $vpn_dev ip daddr $peer_deimos tcp dport 139 counter accept  # samba
		#iifname $vpn_dev oifname $vpn_dev ip daddr $peer_deimos tcp dport 445 counter accept  # samba
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_deimos tcp dport 8096 counter accept  # jellyfin
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_deimos tcp dport 51413 counter accept  # syncthing
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_nemesis tcp dport 22 counter accept  # ssh/borgbackup

		# forward vpn traffic from any vpn peer to specific vpn peers
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_hermes counter accept
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_echo counter accept

		# forward vpn traffic from specific peers to any peer
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_hermes counter accept
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_aether counter accept
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_deimos counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_ares counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_perseus counter accept

		# forward vpn traffic between any peers (LESS SECURE!)
		#iifname $vpn_dev oifname $vpn_dev counter accept

		# forward specific ports from wan to ipv6 vpn peers
		#iifname $wan_dev oifname $vpn_dev ip6 daddr 2a01:4ff:1f0:e308:200::240 tcp dport 22 counter accept

		# forward all traffic from wan to vpn peers (DANGEROUS!)
		# NOTE: this is only relevant for ipv6 peers
		#iifname $wan_dev oifname $vpn_dev counter accept

		# reject all other traffic from vpn peers
		iifname $vpn_dev counter reject

		# forward traffic from wan to specific peer:port
		# NOTE: requires corresponding rules in POSTROUTING and PREROUTING
		iifname $wan_dev oifname $vpn_dev ip daddr $peer_deimos tcp dport 51413 counter accept

		# drop and count everything else
		iifname $wan_dev oifname $vpn_dev counter drop
		iifname $wan_dev counter drop
		counter drop
	}

	chain OUTPUT {
		type filter hook output priority filter; policy accept;
	}

	chain PREROUTING {
		type filter hook prerouting priority -150; policy accept;

		# drop packets in "invalid" connection-tracking state
		ct state invalid counter drop
	}
}

table inet nat {
	chain POSTROUTING {
		type nat hook postrouting priority srcnat; policy accept;

		# drop packets in "invalid" connection-tracking state
		ct state invalid counter drop

		# masquerade specific ipv4 vpn peer traffic to the internet
		# NOTE: requires matching rule in inet filter FORWARD
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_aether counter masquerade
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_deimos counter masquerade
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_ares counter masquerade
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_perseus counter masquerade
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_kodi_lr counter masquerade

		# masquerade all ipv4 vpn peer traffic to the internet (LESS SECURE!)
		#iifname $vpn_dev oifname $wan_dev ip saddr $vpn_net counter masquerade

		# masquerade specific ipv6 vpn peer traffic to the internet
		# comment this out to expose the assigned VPN address to the public
		# NOTE: requires matching rule in inet filter FORWARD
		iifname $vpn_dev oifname $wan_dev ip6 saddr $peer6_ares counter masquerade
		#iifname $vpn_dev oifname $wan_dev ip6 saddr $peer6_perseus counter masquerade

		# masquerade all ipv6 vpn peer traffic to the internet (LESS SECURE!)
		# comment this out to expose the assigned VPN address to the public
		# NOTE: requires matching rule in inet filter FORWARD
		#iifname $vpn_dev oifname $wan_dev ip6 saddr $vpn_net6 counter masquerade

		# track all other routed traffic from vpn
		iifname $vpn_dev oifname $wan_dev counter return
	}
}

table ip nat {
	chain PREROUTING {
		type nat hook prerouting priority dstnat; policy accept;

		# accept all icmp/icmpv6 packets
		meta l4proto { icmp, ipv6-icmp } counter accept

		# accept packets that are part of an established connection
	        ct state established,related counter accept

                # forward ports to another vpn host
                # NOTE: requires matching rule in ip nat POSTROUTING
                tcp dport 51413 counter dnat to $peer_deimos:51413
	}

	chain OUTPUT {
		type nat hook output priority -100; policy accept;
	}

	chain POSTROUTING {
		type nat hook postrouting priority srcnat; policy accept;

		# drop packets in "invalid" connection-tracking state
		ct state invalid counter drop

                # required to support port forwarding
                # NOTE: requires matching rule in ip nat PREROUTING
                meta l4proto tcp ip daddr $peer_deimos tcp dport 51413 counter masquerade
	}
}

# fail2ban table holds blocks which are maintained automatically
# by the fail2ban service.
table inet fail2ban {
        chain INPUT {
                type filter hook input priority -100; policy accept;
                jump USER
        }

        chain FORWARD {
                type filter hook forward priority -100; policy accept;
                jump USER
        }

        chain USER {
        }
}

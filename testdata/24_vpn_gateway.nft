#!/usr/sbin/nft -f

#flush ruleset

define wan_dev = { "eth0" }
define wan_addr = { 203.0.113.251 }
define wan_addr6 = { 2001:db8::1 }
define wan_net6 = { 2001:db8::1/64 }

define vpn_dev = { "wg0" }
define vpn_net = { 10.1.200.0/24 }
define vpn_net6 = { 2001:db8:200::1/80 }

define peer_alpha = { 10.1.200.1, 10.1.200.150 }
define peer_bravo = { 10.1.200.50 }
define peer_charlie = { 10.1.200.115 }
define peer_delta = { 10.1.200.135 }
define peer_foxtrot = { 10.1.200.155 }
define peer_golf = { 10.1.200.170 }
define peer_hotel = { 10.1.200.225 }
define peer_india = { 10.1.200.230 }
define peer_juliet = { 10.1.200.240 }

define peer6_alpha = { 2001:db8:200::150/128 }
define peer6_india = { 2001:db8:200::230/128 }
define peer6_juliet = { 2001:db8:200::240/128 }

table inet filter {
	chain INPUT {
		type filter hook input priority filter; policy drop;

		# accept all loopback packets
		iif "lo" accept

		# accept all ICMP/ICMPv6 packets
		meta l4proto { icmp, ipv6-icmp } counter accept

		# accept packets that are part of an established connection
	        ct state established,related counter accept

		# accept all DHCPv6 packets received at a link-local address
		ip6 daddr fe80::/64 udp dport dhcpv6-client counter accept

		# expose OpenSSH server to WAN and VPN
		iifname $wan_dev tcp dport 22 counter accept
		iifname $vpn_dev tcp dport 22 counter accept

		# expose DNS resolver to VPN
		iifname $vpn_dev udp dport 53 counter accept
		iifname $vpn_dev tcp dport 53 counter accept

		# expose WireGuard server to WAN
		iifname $wan_dev udp dport 51820 counter accept

		# expose iperf server to VPN
		iifname $vpn_dev tcp dport 5201 counter accept

		# expose metrics exporter to some VPN peers
		#iifname $vpn_dev ip saddr $peer_juliet tcp dport 9100 counter accept

		# expose HTTPS reverse proxy to WAN
		iifname $wan_dev tcp dport 443 counter accept

		# reject all other VPN traffic
		iifname $vpn_dev counter reject

		# drop everything else
		iifname $wan_dev counter drop
		counter drop
	}

	chain FORWARD {
		type filter hook forward priority filter; policy drop;

		# accept all ICMP/ICMPv6 packets
		meta l4proto { icmp, ipv6-icmp } counter accept

		# accept packets that are part of an established connection
	        ct state established,related counter accept

		# forward all traffic from specific VPN peers to any WAN peer
		# NOTE: requires matching rule in inet nat POSTROUTING
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_bravo counter accept
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_charlie counter accept
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_juliet counter accept
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_india counter accept
		# FIXME: this is only necessary because this peer ignores AllowedIPs
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_golf counter accept

		# forward all IPv6 traffic from specific VPN peers to any WAN peer
		# NOTE: requires matching rule in inet nat POSTROUTING
		iifname $vpn_dev oifname $wan_dev ip6 saddr $peer6_india counter accept
		#iifname $vpn_dev oifname $wan_dev ip6 saddr $peer6_juliet counter accept

		# forward all traffic from VPN to WAN (LESS SECURE!)
		# NOTE: this is only relevant for IPv6 clients
		#iifname $vpn_dev oifname $wan_dev counter accept

		# forward VPN traffic from specific VPN peer to specific VPN peer:port
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_delta ip daddr $peer_hotel tcp dport 443 counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_delta ip daddr $peer_hotel tcp dport 80 counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_india ip daddr $peer_golf tcp dport 8080 counter accept

		# forward VPN traffic between specific VPN peers
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_india ip daddr $peer_bravo counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_india ip daddr $peer_charlie counter accept
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_juliet ip daddr $peer_foxtrot counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_india ip daddr $peer_golf counter accept

		# forward VPN traffic from any VPN peer to specific VPN peer:port
		# FIXME: charlie 443 is a pretty large attack vector
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_charlie tcp dport 443 counter accept
		#iifname $vpn_dev oifname $vpn_dev ip daddr $peer_charlie tcp dport 139 counter accept  # samba
		#iifname $vpn_dev oifname $vpn_dev ip daddr $peer_charlie tcp dport 445 counter accept  # samba
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_charlie tcp dport 3000 counter accept  # wiki
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_charlie tcp dport 4242 counter accept  # game server
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_foxtrot tcp dport 22 counter accept  # SSH/backups

		# forward VPN traffic from any VPN peer to specific VPN peers
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_alpha counter accept
		iifname $vpn_dev oifname $vpn_dev ip daddr $peer_delta counter accept

		# forward VPN traffic from specific peers to any peer
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_alpha counter accept
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_bravo counter accept
		#iifname $vpn_dev oifname $vpn_dev ip saddr $peer_charlie counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_india counter accept
		iifname $vpn_dev oifname $vpn_dev ip saddr $peer_juliet counter accept

		# forward VPN traffic between any peers (LESS SECURE!)
		#iifname $vpn_dev oifname $vpn_dev counter accept

		# forward specific ports from WAN to IPv6 VPN peers
		#iifname $wan_dev oifname $vpn_dev ip6 daddr 2001:db8:200::240 tcp dport 22 counter accept

		# forward all traffic from WAN to VPN peers (DANGEROUS!)
		# NOTE: this is only relevant for IPv6 peers
		#iifname $wan_dev oifname $vpn_dev counter accept

		# reject all other traffic from VPN peers
		iifname $vpn_dev counter reject

		# forward traffic from WAN to specific peer:port
		# NOTE: requires corresponding rules in POSTROUTING and PREROUTING
		iifname $wan_dev oifname $vpn_dev ip daddr $peer_charlie tcp dport 4242 counter accept

		# drop and count everything else
		iifname $wan_dev oifname $vpn_dev counter drop
		iifname $wan_dev counter drop
		counter drop
	}

	chain OUTPUT {
		type filter hook output priority filter; policy accept;
	}

	chain PREROUTING {
		type filter hook prerouting priority -150; policy accept;

		# drop packets in "invalid" connection-tracking state
		ct state invalid counter drop
	}
}

table inet nat {
	chain POSTROUTING {
		type nat hook postrouting priority srcnat; policy accept;

		# drop packets in "invalid" connection-tracking state
		ct state invalid counter drop

		# masquerade specific IPv4 VPN peer traffic to the internet
		# NOTE: requires matching rule in inet filter FORWARD
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_bravo counter masquerade
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_charlie counter masquerade
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_india counter masquerade
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_juliet counter masquerade
		iifname $vpn_dev oifname $wan_dev ip saddr $peer_golf counter masquerade

		# masquerade all IPv4 VPN peer traffic to the internet (LESS SECURE!)
		#iifname $vpn_dev oifname $wan_dev ip saddr $vpn_net counter masquerade

		# masquerade specific IPv6 VPN peer traffic to the internet
		# comment this out to expose the assigned VPN address to the public
		# NOTE: requires matching rule in inet filter FORWARD
		iifname $vpn_dev oifname $wan_dev ip6 saddr $peer6_india counter masquerade
		#iifname $vpn_dev oifname $wan_dev ip6 saddr $peer6_juliet counter masquerade

		# masquerade all IPv6 VPN peer traffic to the internet (LESS SECURE!)
		# comment this out to expose the assigned VPN address to the public
		# NOTE: requires matching rule in inet filter FORWARD
		#iifname $vpn_dev oifname $wan_dev ip6 saddr $vpn_net6 counter masquerade

		# track all other routed traffic from VPN
		iifname $vpn_dev oifname $wan_dev counter return
	}
}

table ip nat {
	chain PREROUTING {
		type nat hook prerouting priority dstnat; policy accept;

		# accept all ICMP/ICMPv6 packets
		meta l4proto { icmp, ipv6-icmp } counter accept

		# accept packets that are part of an established connection
	        ct state established,related counter accept

                # forward ports to another VPN host
                # NOTE: requires matching rule in ip nat POSTROUTING
                tcp dport 4242 counter dnat to $peer_charlie:4242
	}

	chain OUTPUT {
		type nat hook output priority -100; policy accept;
	}

	chain POSTROUTING {
		type nat hook postrouting priority srcnat; policy accept;

		# drop packets in "invalid" connection-tracking state
		ct state invalid counter drop

                # required to support port forwarding
                # NOTE: requires matching rule in ip nat PREROUTING
                meta l4proto tcp ip daddr $peer_charlie tcp dport 4242 counter masquerade
	}
}

# fail2ban table holds blocks which are maintained automatically
# by the fail2ban service.
table inet fail2ban {
        chain INPUT {
                type filter hook input priority -100; policy accept;
                jump USER
        }

        chain FORWARD {
                type filter hook forward priority -100; policy accept;
                jump USER
        }

        chain USER {
        }
}

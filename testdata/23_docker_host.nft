#!/usr/sbin/nft -f

#flush ruleset

define wan_dev = { "enp1s0" }

define dns_net = { 8.8.8.8, 8.8.4.4 }

define docker_dev = { "docker0", "docker1" }
define docker_net = { 172.16.0.0/16, 172.17.0.0/16 }

define cnt_resolver_addr = "172.16.0.5"
define cnt_mail_addr = "172.16.0.7"
define cnt_proxy_addr = "172.16.0.9"
define cnt_acme_addr = "172.16.0.11"
define cnt_backup_addr = "172.16.0.13"
define cnt_files_addr = "172.16.0.15"
define cnt_git_addr = "172.16.0.17"
define cnt_wiki_addr = "172.16.0.19"
define cnt_feeds_addr = "172.16.0.21"
define cnt_notebook_addr = "172.16.0.23"

define vpn_dev = { "wg0" }
define vpn_net = { 10.1.200.0/24 }
#define vpn_net6 = { 2001:db8:200::1/80 }

table inet nat {
        chain POSTROUTING {
                type nat hook postrouting priority srcnat; policy accept;

                # drop packets in "invalid" connection-tracking state
                ct state invalid counter drop
        }
}

table ip nat {
        chain PREROUTING {
                type nat hook prerouting priority dstnat; policy accept;

                # accept all ICMP/ICMPv6 packets
                meta l4proto { icmp, ipv6-icmp } counter accept

                # accept packets that are part of an established connection
                ct state established,related counter accept

                # Docker baseline rules
                fib daddr type local counter jump DOCKER
        }

        chain OUTPUT {
                type nat hook output priority -100; policy accept;

                # Docker baseline rules
                ip daddr != 127.0.0.0/8 fib daddr type local counter jump DOCKER
        }

        chain POSTROUTING {
                type nat hook postrouting priority srcnat; policy accept;

                # drop packets in "invalid" connection-tracking state
                ct state invalid counter drop

                # Docker baseline rules
                oifname != "docker0" ip saddr 172.17.0.0/16 counter masquerade
                oifname != "docker1" ip saddr 172.16.0.0/16 counter masquerade
        }

        chain DOCKER {
                # Docker baseline rules
                iifname "docker0" counter return
                iifname "docker1" counter return

                # Docker container ports which are exposed to all interfaces
                #meta l4proto tcp tcp dport 25 counter dnat to $cnt_mail_addr:25
                #meta l4proto tcp tcp dport 53 counter dnat to $cnt_resolver_addr:53
                #meta l4proto udp udp dport 53 counter dnat to $cnt_resolver_addr:53
                #meta l4proto tcp tcp dport 443 counter dnat to $cnt_proxy_addr:443

                # Docker container ports which are exposed to VPN
                # n.b. for these to be effective, there must also be an accompanying rule in the filter table
                iifname $vpn_dev meta l4proto tcp tcp dport 139 counter dnat to $cnt_files_addr:139
                iifname $vpn_dev meta l4proto tcp tcp dport 445 counter dnat to $cnt_files_addr:445
                #iifname $vpn_dev meta l4proto tcp tcp dport 143 counter dnat to $cnt_mail_addr:143
                #iifname $vpn_dev meta l4proto tcp tcp dport 443 counter dnat to $cnt_proxy_addr:443
                #iifname $vpn_dev meta l4proto tcp tcp dport 587 counter dnat to $cnt_mail_addr:587
                iifname $vpn_dev meta l4proto tcp tcp dport 2222 counter dnat to $cnt_git_addr:22
                #iifname $vpn_dev meta l4proto tcp tcp dport 8070 counter dnat to $cnt_notify_addr:80
                iifname $vpn_dev meta l4proto tcp tcp dport 3000 counter dnat to $cnt_wiki_addr:3000
                #iifname $vpn_dev meta l4proto tcp tcp dport 9091 counter dnat to $cnt_notebook_addr:9091
                iifname $vpn_dev meta l4proto tcp tcp dport 8890 counter dnat to $cnt_notebook_addr:8888
                iifname $vpn_dev meta l4proto tcp tcp dport 8200 counter dnat to $cnt_backup_addr:8200
                iifname $vpn_dev meta l4proto tcp tcp dport 8081 counter dnat to $cnt_feeds_addr:8081

                # reject other VPN traffic to Docker containers
                iifname $vpn_dev oifname $docker_dev counter reject

                counter return
        }
}

table inet filter {
        chain INPUT {
                type filter hook input priority filter; policy drop;

                # accept all loopback packets
                iif "lo" accept

                # accept all ICMP/ICMPv6 packets
                meta l4proto { icmp, ipv6-icmp } counter accept

                # accept packets that are part of an established connection
                ct state established,related counter accept

                # accept all DHCPv6 packets received at a link-local address
                ip6 daddr fe80::/64 udp dport dhcpv6-client counter accept

                # expose OpenSSH server to WAN and VPN
                iifname $wan_dev tcp dport 22 counter accept
                iifname $vpn_dev tcp dport 22 counter accept

                # expose DNS server on 172.16.0.1 to containers
                iifname $docker_dev udp dport 53 counter accept
                iifname $docker_dev tcp dport 53 counter accept

                # expose host-mode proxy container to VPN
                iifname $vpn_dev tcp dport 443 counter accept

                # expose metrics exporter to VPN
                iifname $vpn_dev tcp dport 9100 counter accept

                # expose package proxy on 172.16.0.1 to containers
                iifname $docker_dev tcp dport 8000 counter accept

                # reject all other traffic from Docker containers
                iifname $docker_dev counter reject
        }

        chain FORWARD {
                type filter hook forward priority filter; policy drop;

                # accept packets that are part of an established connection
                ct state established,related counter accept

                # Docker baseline rules
                counter jump DOCKER-ISOLATION-STAGE-1
                oifname "docker0" ct state related,established counter accept
                oifname "docker0" counter jump DOCKER
                iifname "docker0" oifname != "docker0" counter accept
                iifname "docker0" oifname "docker0" counter accept
                oifname "docker1" ct state related,established counter accept
                oifname "docker1" counter jump DOCKER
                iifname "docker1" oifname != "docker1" counter accept
                iifname "docker1" oifname "docker1" counter accept
                iifname "docker2" oifname "docker2" counter accept

                # reject all other packets on Docker interfaces
                oifname $docker_dev counter reject
                iifname $docker_dev counter reject

                counter return
        }

        chain OUTPUT {
                type filter hook output priority filter; policy accept;
        }

        chain PREROUTING {
                type filter hook prerouting priority -150; policy accept;

                # drop packets in "invalid" connection-tracking state
                ct state invalid counter drop
        }

        # Docker baseline rules
        chain DOCKER-ISOLATION-STAGE-1 {
                iifname "docker0" oifname != "docker0" counter jump DOCKER-ISOLATION-STAGE-2
                iifname "docker1" oifname != "docker1" counter jump DOCKER-ISOLATION-STAGE-2
                oifname "docker2" ip saddr != 172.32.0.0/16 counter drop
                iifname "docker2" ip daddr != 172.32.0.0/16 counter drop
        }

        # Docker baseline rules
        chain DOCKER-ISOLATION-STAGE-2 {
                oifname "docker0" counter drop
                oifname "docker1" counter drop
                counter return
        }

        # Docker container rules
        chain DOCKER {
                iifname "docker1" counter return
                oifname != "docker1" counter return

                # container ports which are exposed to other interfaces must be present here
                #meta l4proto tcp ip daddr $cnt_resolver_addr tcp dport 53 counter accept
                #meta l4proto udp ip daddr $cnt_resolver_addr udp dport 53 counter accept
                #meta l4proto tcp ip daddr $cnt_mail_addr tcp dport 25 counter accept
                #meta l4proto tcp ip daddr $cnt_mail_addr tcp dport 587 counter accept
                #meta l4proto tcp ip daddr $cnt_mail_addr tcp dport 143 counter accept
                meta l4proto tcp ip daddr $cnt_files_addr tcp dport 139 counter accept
                meta l4proto tcp ip daddr $cnt_files_addr tcp dport 445 counter accept
                #meta l4proto tcp ip daddr $cnt_proxy_addr tcp dport 443 counter accept
                meta l4proto tcp ip daddr $cnt_git_addr tcp dport 22 counter accept
                #meta l4proto tcp ip daddr $cnt_notify_addr tcp dport 80 counter accept
                meta l4proto tcp ip daddr $cnt_wiki_addr tcp dport 3000 counter accept
                #meta l4proto tcp ip daddr $cnt_notebook_addr tcp dport 9091 counter accept
                meta l4proto tcp ip daddr $cnt_notebook_addr tcp dport 8888 counter accept
                meta l4proto tcp ip daddr $cnt_backup_addr tcp dport 8200 counter accept
                meta l4proto tcp ip daddr $cnt_feeds_addr tcp dport 8081 counter accept

                # reject other VPN traffic to Docker containers
                iifname $vpn_dev oifname $docker_dev counter reject

                counter return
        }
}

# fail2ban table holds blocks which are maintained automatically
# by the fail2ban service.
table inet fail2ban {
        chain INPUT {
                type filter hook input priority -100;
                jump USER
        }
        chain FORWARD {
                type filter hook forward priority -100;
                jump USER
        }
        chain USER {}
}
